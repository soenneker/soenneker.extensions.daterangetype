<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Test" Version="11.0.345" />
        <PackageReference Include="Soenneker.Tests.HostedUnit" Version="11.0.346" />
        <PackageReference Include="Soenneker.Utils.TimeZones" Version="11.0.781" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Extensions.DateRangeType\Soenneker.Extensions.DateRangeType.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Extensions.DateTimeOffsets" Version="11.0.194" />
        <PackageReference Include="Soenneker.Extensions.DateTimeOffsets.Months" Version="11.0.167" />
    </ItemGroup>
</Project>

